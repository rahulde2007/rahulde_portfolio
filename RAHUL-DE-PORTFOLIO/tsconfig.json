{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "script.js",
    "api/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "RAHUL-DE-PORTFOLIO"
  ]
}
